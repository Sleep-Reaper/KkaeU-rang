<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />
    <uses-permission android:name="pleos.car.permission.NAVI_CUSTOM_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_CUSTOM_MAP" />
    <uses-permission android:name="pleos.car.permission.NAVI_CUSTOM_ETC" />

    <!-- 졸음 판단: 차량 신호 수집 -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />    <!-- 핸들, 브레이크 -->
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />   <!-- 방향지시등 -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />  <!-- 차속 -->
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" /> <!-- 기어 -->

    <!-- 졸음 대응: 창문 열기·찬바람 -->
    <uses-permission android:name="pleos.car.permission.CAR_WINDOWS" />          <!-- 창문 위치 읽기, 와이퍼(비) 상태 -->
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_WINDOWS" />  <!-- 창문 열고 닫기 -->
    <uses-permission android:name="pleos.car.permission.CAR_CLIMATE" />          <!-- 공조 상태 읽기 -->
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_CLIMATE" />  <!-- 에어컨·풍량·외기 제어 -->

    <!-- 졸음 감시 포그라운드 서비스 (화면을 바꿔도 계속 동작) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />   <!-- 음성 대답 듣기, 마이크 타입 서비스 시작 조건 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.KkaeUrang">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.KkaeUrang.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".integration.DrowsinessService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
    </application>

</manifest>